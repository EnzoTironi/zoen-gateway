      "method": "GET",
      "path": "/people/email",
      "base_url": "mock://apollo",
      "access": "platform",
      "cost_micro": 8000,
      "query": {
        "domain": { "type": "string", "required": true, "example": "stripe.com" },
        "full_name": { "type": "string", "required": true, "example": "Patrick Collison" }
      }
    },
    {
      "id": "treg.people.email.find",
      "capability": "people.email.find",
      "provider": "treg",
      "name": "Encontrar e-mail (roteado)",
      "summary": "treg escolhe o provedor. A resposta nomeia o filho que atendeu.",
      "jobs": ["encontrar e-mail", "find work email", "roteado", "capability"],
      "method": "POST",
      "path": "/route/people.email.find",
      "base_url": "mock://treg",
