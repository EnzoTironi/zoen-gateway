      "method": "GET",
      "path": "/strict",
      "base_url": "mock://demo",
      "access": "anonymous",
      "cost_micro": 0,
      "strict_query": true,
      "query": {
        "text": { "type": "string", "required": true, "example": "olá" }
      }
