    {
      "id": "hunter.people.email.find",
      "capability": "people.email.find",
      "provider": "hunter",
      "name": "Encontrar e-mail profissional",
      "summary": "Encontra o e-mail de trabalho a partir do nome e do domínio da empresa.",
