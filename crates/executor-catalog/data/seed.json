      "method": "GET",
      "path": "/email-verifier",
      "base_url": "mock://hunter",
      "access": "platform",
      "cost_micro": 5000,
      "query": {
        "email": { "type": "string", "required": true, "example": "hello@example.com" }
      }
    },
    {
      "id": "apollo.people.email.find",
      "capability": "people.email.find",
