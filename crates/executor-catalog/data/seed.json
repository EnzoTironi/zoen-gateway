        "hunter"
      ],
      "method": "GET",
      "path": "/email-finder",
      "base_url": "mock://hunter",
      "access": "platform",
      "cost_micro": 10000,
      "query": {
        "domain": { "type": "string", "required": true, "example": "stripe.com" },
        "full_name": { "type": "string", "required": true, "example": "Patrick Collison" }
      }
    },
    {
      "id": "hunter.people.email.verify",
      "capability": "people.email.verify",
      "provider": "hunter",
